# systemd unit for sshhub. Installed by deploy/setup.sh.
# Check the sandboxing with: systemd-analyze security sshhub
[Unit]
Description=SSH Hub
Documentation=https://github.com/Dimitry4Now/sshhub
After=network-online.target
Wants=network-online.target

[Service]
User=sshhub
Group=sshhub
ExecStart=/usr/local/bin/sshhub -addr :23234 -db /var/lib/sshhub/hub.db -hostkey /var/lib/sshhub/host_ed25519
WorkingDirectory=/var/lib/sshhub
# Creates /var/lib/sshhub owned by the service user; the database and the
# host key live there. Losing the host key makes every client warn that the
# server's identity changed, so back this directory up.
StateDirectory=sshhub
StateDirectoryMode=0700
UMask=0077

Restart=on-failure
RestartSec=2s
# Sessions get a few seconds to see the restart notice before the server closes.
TimeoutStopSec=20s

# Resource limits: a busy hub stays well under these.
MemoryMax=512M
TasksMax=512
LimitNOFILE=4096

# Sandboxing: the service only needs to listen on a port and write its state.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
